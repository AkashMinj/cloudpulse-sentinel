# Copy to .env. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cloudpulse
DB_USER=cloudpulse_admin
DB_PASSWORD=REPLACE_WITH_ROTATED_DATABASE_PASSWORD
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AWS_REGION=us-east-1
ML_MODEL_BUCKET=
METRICS_ARCHIVE_BUCKET=
CLOUDPULSE_SQS_QUEUE_URL=
CLOUDPULSE_SNS_TOPIC_ARN=

# Generate with: openssl rand -hex 32. Required to accept remote instance telemetry.
METRICS_INGEST_TOKEN=

# Optional notification providers (leave blank to disable).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
SLACK_WEBHOOK_URL=

# Local Compose periodic collection interval (seconds).
COLLECTION_INTERVAL_SECONDS=30
